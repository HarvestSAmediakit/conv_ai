# ==============================================================================
#                      CONVOMAG AI - DOCKER CONTEXT IGNORE
# ==============================================================================
# Exclude folders and files matching these patterns from being compiled into 
# the Docker daemon build context, speeding up builds and enforcing code security.

# Local Dependency Directories
node_modules
jspm_packages
web_modules
.npm
.cache

# Development Tooling & Editor States
.git
.github
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Dynamic Build and Output Files
dist
dist-server
server.js
server.js.map
*.tsbuildinfo

# Local Persisted Database Files (prevent shipping local database records)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.db
*.db-journal
*.db-wal
data/
uploads/*
!uploads/.gitkeep

# Local Environmental Configuration Assets
.env
.env.production
.env.local
.env.*.local
secrets/

# Diagnostic Logs and Crash Reports
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage Collections
coverage
.nyc_output
.test
tests/
__tests__/
cypress/
*.test.ts
*.spec.ts
